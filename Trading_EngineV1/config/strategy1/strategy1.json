{
  "order": {"position": 50, "leverage": 5},
  "monitor": {
    "exchange1_id": "binance",
    "exchange2_id": null,
    "n_days": 2.5,
    "threshold": 0.08,
    "value_threshold": 0,
    "placed_symbols": 10,
    "_comment": "Set exchange2_id to null for single-exchange mode, or specify an exchange name (e.g., 'binance') for cross-exchange mode"
  },
  "output": {
    "image_path": "funding_arbitrage_table.png",
    "dpi": 300,
    "delete_after_send": true
  },

  "discord": {
    "webhook_url": "",
    "channel_id": "posting_monitor",
    "enabled": true
  },
  "monitoring": {
    "interval": 5,
    "position_monitoring": true,
    "performance_monitoring": true
  },
  "alerts": {
    "position": {
      "enabled": true,
      "pnl_loss_threshold": -10.0,
      "position_value_threshold": 1000.0,
      "leverage_threshold": 10.0,
      "margin_ratio_threshold": 0.8
    }
  },
  "reports": {
    "auto": true,
    "interval_hours": 24
  }
}